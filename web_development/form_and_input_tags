<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forms and input tags</title>
</head>
<body>
    <h2>This is html and forms</h2>
    <form action="backend.php">
    <label for="name">Name</label><br>
    <div><input type="text" name="myname" id="name"></div><br>
    <label for="roll">Roll</label>
    <div><input type="number" name="myRoll" id="roll"></div><br>
    <label for="Email">email</label>
    <div><input type="email" name="myEmail" id="Email"></div><br>
    <label for="date">Date</label>
    <div><input type="date" name="mydate"  id="date"></div><br>
    <div>Are you eligible: <input type="checkbox" name="mycheckbutton"></div><br>
    <div>Gender: Male<input type="radio" name="myGender">
        Female<input type="radio" name="myGender"></div><br>
    <div><input type="reset" value="reset now"></div><br>
    <div>write text:<textarea name="mytext" cols="30" rows="10"></textarea></div><br>
    <label for="car">Car</label>
    <select name="mycar" id="car">
        <option value="indica">indica</option>
        <option value="farari">farari</option>
        <option value="BMW">BMW</option>
    </select>    
    <input type="submit" value="submit now">
    </form>
</body>
</html>
